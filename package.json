{
  "name": "downora-backend",
  "version": "0.1.0",
  "private": true,
  "description": "DOWNORA backend foundation: URL analysis, platform detection, provider adapters",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "test:unit": "node --test tests/unit.test.js",
    "check": "node --check server.js && node --check app.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0"
  }
}
