NODE_ENV=development
PORT=3000

# Origin frontend yang diizinkan (pisahkan dengan koma; tanpa slash akhir).
# KOSONGKAN jika frontend disajikan oleh backend ini (cara standar, satu origin).
# Isi hanya jika frontend di-host di domain lain, mis. https://nama-situs.netlify.app
CORS_ORIGINS=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Untuk satu reverse proxy tepercaya (misalnya konfigurasi standar Render):
# TRUST_PROXY=1
TRUST_PROXY=
